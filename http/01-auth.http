###############################################################################
# AUTH — регистрация, вход, обмен refresh-токена и всё, что может пойти не так.
#
# Самодостаточный: создаёт своих пользователей с уникальными логинами,
# поэтому запускается сколько угодно раз подряд. Запуск — сверху вниз.
###############################################################################

# ═════════════════════════════════════════════════════════════════════════════
# РЕГИСТРАЦИЯ
# ═════════════════════════════════════════════════════════════════════════════

### Регистрация основного пользователя
# @name Регистрация основного пользователя
< {%
    const login = "auth_" + Date.now();
    request.variables.set("login", login);
    client.global.set("auth_login", login);
%}
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "login": "{{login}}",
  "email": "{{login}}@example.com",
  "password": "{{password}}",
  "age": 28,
  "about": "основной пользователь auth-тестов"
}

> {%
    client.test("201 Created", () => client.assert(response.status === 201, `пришло ${response.status}`));
    client.test("в ответе оба токена", () => {
        client.assert(typeof response.body.access_token === "string", "нет access_token");
        client.assert(typeof response.body.refresh_token === "string", "нет refresh_token");
    });
    client.test("токены разные", () => {
        client.assert(response.body.access_token !== response.body.refresh_token, "access и refresh совпали");
    });

    client.global.set("auth_access", response.body.access_token);
    client.global.set("auth_refresh", response.body.refresh_token);
%}


### Регистрация второго пользователя — нужен, чтобы проверить изоляцию сессий
# @name Регистрация второго пользователя
< {%
    const login = "auth2_" + Date.now();
    request.variables.set("login", login);
%}
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "login": "{{login}}",
  "email": "{{login}}@example.com",
  "password": "{{password}}",
  "age": 27
}

> {%
    client.test("201 Created", () => client.assert(response.status === 201, `пришло ${response.status}`));
    client.global.set("auth_second_refresh", response.body.refresh_token);
%}


