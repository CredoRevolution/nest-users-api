### Вход — 200 и новая пара токенов
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "login": "{{auth_login}}",
  "password": "{{password}}"
}

> {%
    client.test("200 OK", () => client.assert(response.status === 200, `пришло ${response.status}`));
    client.test("в ответе оба токена", () => {
        client.assert(response.body.access_token && response.body.refresh_token, "нет токенов");
    });

    client.global.set("auth_access", response.body.access_token);
    client.global.set("auth_refresh", response.body.refresh_token);
%}


### Неверный пароль — 401
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "login": "{{auth_login}}",
  "password": "wrong-password"
}

> {%
    client.test("401 Unauthorized", () => client.assert(response.status === 401, `пришло ${response.status}`));
    client.global.set("auth_wrong_password_message", response.body.message);
%}


### Несуществующий логин — 401 с тем же текстом, что при неверном пароле
# Если тексты отличаются, перебором можно узнать, какие логины заняты.
# @name Несуществующий логин
< {%
    request.variables.set("login", "nobody_" + Date.now());
%}
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "login": "{{login}}",
  "password": "{{password}}"
}

> {%
    client.test("401 Unauthorized", () => client.assert(response.status === 401, `пришло ${response.status}`));
    client.test("текст как при неверном пароле", () => {
        const expected = client.global.get("auth_wrong_password_message");
        client.assert(response.body.message === expected, `«${response.body.message}» ≠ «${expected}»`);
    });
%}


