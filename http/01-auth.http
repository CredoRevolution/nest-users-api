# ═════════════════════════════════════════════════════════════════════════════
# ОБМЕН REFRESH-ТОКЕНА
# ═════════════════════════════════════════════════════════════════════════════

### Refresh — 200, пара полностью новая
POST {{baseUrl}}/auth/refresh
Content-Type: application/json

{
  "refresh_token": "{{auth_refresh}}"
}

> {%
    const oldRefresh = client.global.get("auth_refresh");

    client.test("200 OK", () => client.assert(response.status === 200, `пришло ${response.status}`));
    client.test("refresh-токен новый", () => client.assert(response.body.refresh_token !== oldRefresh, "вернулся старый refresh"));

    client.global.set("auth_old_refresh", oldRefresh);
    client.global.set("auth_access", response.body.access_token);
    client.global.set("auth_refresh", response.body.refresh_token);
%}


### Новый access-токен пускает
GET {{baseUrl}}/profile/my
Authorization: Bearer {{auth_access}}

> {%
    client.test("200 OK", () => client.assert(response.status === 200, `пришло ${response.status}`));
    client.test("это наш пользователь", () => {
        client.assert(response.body.login === client.global.get("auth_login"), `login = ${response.body.login}`);
    });
%}


### Старый refresh повторно — 401
# Повтор считается кражей: сервер отзывает ВСЕ refresh-токены пользователя.
POST {{baseUrl}}/auth/refresh
Content-Type: application/json

{
  "refresh_token": "{{auth_old_refresh}}"
}

> {%
    client.test("401 Unauthorized", () => client.assert(response.status === 401, `пришло ${response.status} — старый токен живой`));
%}


### Честно полученный refresh после кражи тоже мёртв — 401
POST {{baseUrl}}/auth/refresh
Content-Type: application/json

{
  "refresh_token": "{{auth_refresh}}"
}

> {%
    client.test("401 Unauthorized", () => client.assert(response.status === 401, `пришло ${response.status} — reuse detection не сработал`));
%}


### Access-токен после кражи работает до своего истечения — 200
# Отзываются только refresh. Access живёт свои 15 минут, он в базе не хранится.
GET {{baseUrl}}/profile/my
Authorization: Bearer {{auth_access}}

> {%
    client.test("200 OK", () => client.assert(response.status === 200, `пришло ${response.status}`));
%}


