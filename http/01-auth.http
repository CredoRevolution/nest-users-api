# ─────────────────────────────────────────────────────────────────────────────
# Дубликаты — 409
# ─────────────────────────────────────────────────────────────────────────────

### Занятый логин — 409
# @name Занятый логин
< {%
    request.variables.set("email", "other_" + Date.now() + "@example.com");
%}
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "login": "{{auth_login}}",
  "email": "{{email}}",
  "password": "{{password}}",
  "age": 28
}

> {%
    client.test("409 Conflict", () => client.assert(response.status === 409, `пришло ${response.status}`));
    client.test("в сообщении про логин", () => client.assert(/login/.test(response.body.message), response.body.message));
%}


### Занятый email — 409
# @name Занятый email
< {%
    request.variables.set("login", "other_" + Date.now());
%}
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "login": "{{login}}",
  "email": "{{auth_login}}@example.com",
  "password": "{{password}}",
  "age": 28
}

> {%
    client.test("409 Conflict", () => client.assert(response.status === 409, `пришло ${response.status}`));
    client.test("в сообщении про email", () => client.assert(/email/.test(response.body.message), response.body.message));
%}


# ─────────────────────────────────────────────────────────────────────────────
# Валидация тела — 400. До базы такие запросы не доходят, поэтому логины
# здесь можно не делать уникальными.
# ─────────────────────────────────────────────────────────────────────────────

### Пустое тело — 400, ошибка по каждому обязательному полю
POST {{baseUrl}}/auth/register
Content-Type: application/json

{}

> {%
    client.test("400 Bad Request", () => client.assert(response.status === 400, `пришло ${response.status}`));
    client.test("перечислены все обязательные поля", () => {
        const text = response.body.message.join("; ");
        for (const field of ["login", "email", "password", "age"]) {
            client.assert(text.includes(`${field} is required`), `нет ошибки про ${field}: ${text}`);
        }
    });
%}


### Кривой email — 400
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "login": "bad_email",
  "email": "это-вообще-не-почта",
  "password": "{{password}}",
  "age": 28
}

> {%
    client.test("400 Bad Request", () => client.assert(response.status === 400, `пришло ${response.status}`));
    client.test("ошибка про email", () => client.assert(response.body.message.includes("email is invalid"), response.body.message));
%}


### Лишние поля — 400 (forbidNonWhitelisted в main.ts)
# С одним whitelist: true было бы 201, а поля молча выкинуло бы.
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "login": "extra_fields",
  "email": "extra_fields@example.com",
  "password": "{{password}}",
  "age": 28,
  "isAdmin": true,
  "passwordHash": "попытка подсунуть свой хэш"
}

> {%
    client.test("400 Bad Request", () => client.assert(response.status === 400, `пришло ${response.status}`));
    client.test("названы оба лишних поля", () => {
        const text = response.body.message.join("; ");
        client.assert(text.includes("isAdmin") && text.includes("passwordHash"), text);
    });
%}


