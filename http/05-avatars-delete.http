### Слот 5 из 5 — удалённая аватарка место не занимает
POST {{baseUrl}}/profile/my/avatars
Authorization: Bearer {{del_access_token}}
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="avatar"; filename="avatar.png"
Content-Type: image/png

< ./fixtures/avatar.png
--boundary--

> {%
    client.test("слот 5 = 201, удалённая в лимит не считается", function () {
        client.assert(response.status === 201, "ожидали 201, пришло " + response.status);
    });
    client.global.set("last_avatar_id", response.body.id);
%}


### Шестая — ожидаем 409
POST {{baseUrl}}/profile/my/avatars
Authorization: Bearer {{del_access_token}}
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="avatar"; filename="avatar.png"
Content-Type: image/png

< ./fixtures/avatar.png
--boundary--

> {%
    client.test("шестая при лимите 5 = 409", function () {
        client.assert(response.status === 409, "ожидали 409, пришло " + response.status);
    });
%}


### Удаляем одну — ожидаем 204
DELETE {{baseUrl}}/profile/my/avatars/{{last_avatar_id}}
Authorization: Bearer {{del_access_token}}

> {%
    client.test("удаление при полном лимите = 204", function () {
        client.assert(response.status === 204, "ожидали 204, пришло " + response.status);
    });
%}


### Снова шестая — теперь место есть, ожидаем 201
POST {{baseUrl}}/profile/my/avatars
Authorization: Bearer {{del_access_token}}
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="avatar"; filename="avatar.png"
Content-Type: image/png

< ./fixtures/avatar.png
--boundary--

> {%
    client.test("после удаления место освободилось = 201", function () {
        client.assert(response.status === 201, "ожидали 201, пришло " + response.status);
    });
%}
