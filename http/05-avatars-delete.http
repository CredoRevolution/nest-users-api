###############################################################################
# AVATARS — DELETE /profile/my/avatars/:id: удаление своей аватарки.
# Удаление мягкое: в записи проставляется deletedAt, файл в бакете остаётся.
# Удалённая аватарка не считается в лимите в 5 активных аватарок.
#
# Перед запуском — то же, что для 04-upload.http: docker compose up -d,
# в .env настроен S3, бакет создан.
#
# Файл самодостаточный: регистрирует двух одноразовых пользователей —
# владельца аватарок и чужого — и сам загружает картинки, которые удаляет.
# Запускай сверху вниз.
###############################################################################

### Владелец аватарок
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "login": "del_owner_{{$timestamp}}",
  "email": "del_owner_{{$timestamp}}@example.com",
  "password": "qwerty123",
  "age": 30
}

> {%
    client.global.set("del_access_token", response.body.access_token);
    client.global.set("del_refresh_token", response.body.refresh_token);
%}


### Чужой пользователь — у него своя аватарка, которую владелец удалить не должен
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "login": "del_other_{{$timestamp}}",
  "email": "del_other_{{$timestamp}}@example.com",
  "password": "qwerty123",
  "age": 30
}

> {%
    client.global.set("del_other_access_token", response.body.access_token);
%}


### Чужой загружает свою аватарку
POST {{baseUrl}}/profile/my/avatars
Authorization: Bearer {{del_other_access_token}}
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="avatar"; filename="avatar.png"
Content-Type: image/png

< ./fixtures/avatar.png
--boundary--

> {%
    client.test("аватарка чужого загружена = 201", function () {
        client.assert(response.status === 201, "ожидали 201, пришло " + response.status);
    });
    client.global.set("foreign_avatar_id", response.body.id);
%}


### Владелец загружает свою аватарку
POST {{baseUrl}}/profile/my/avatars
Authorization: Bearer {{del_access_token}}
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="avatar"; filename="avatar.png"
Content-Type: image/png

< ./fixtures/avatar.png
--boundary--

> {%
    client.test("аватарка владельца загружена = 201", function () {
        client.assert(response.status === 201, "ожидали 201, пришло " + response.status);
    });
    client.global.set("own_avatar_id", response.body.id);
%}


# ─────────────────────────────────────────────────────────────────────────────
# АВТОРИЗАЦИЯ — ожидаем 401. Бьём в существующую аватарку владельца:
# ниже её удаление проходит с 204, значит, эти запросы её не тронули.
# ─────────────────────────────────────────────────────────────────────────────

### Без токена — ожидаем 401
DELETE {{baseUrl}}/profile/my/avatars/{{own_avatar_id}}

> {%
    client.test("без токена = 401", function () {
        client.assert(response.status === 401, "ожидали 401, пришло " + response.status);
    });
%}


### REFRESH-токен вместо access — ожидаем 401
DELETE {{baseUrl}}/profile/my/avatars/{{own_avatar_id}}
Authorization: Bearer {{del_refresh_token}}

> {%
    client.test("refresh вместо access = 401", function () {
        client.assert(response.status === 401, "ожидали 401, пришло " + response.status);
    });
%}


### Мусор вместо токена — ожидаем 401
DELETE {{baseUrl}}/profile/my/avatars/{{own_avatar_id}}
Authorization: Bearer это-не-токен

> {%
    client.test("мусор вместо токена = 401", function () {
        client.assert(response.status === 401, "ожидали 401, пришло " + response.status);
    });
%}


# ─────────────────────────────────────────────────────────────────────────────
# ЧУЖАЯ АВАТАРКА — ожидаем 403
# ─────────────────────────────────────────────────────────────────────────────

### Владелец пытается удалить аватарку чужого — ожидаем 403
# 403 честно говорит «такая аватарка есть, но она не твоя», то есть по нему
# можно перебором узнать, какие id заняты. Альтернатива — отвечать 404,
# как будто аватарки нет. id тут SERIAL и угадываются и так, поэтому
# 403 защитим — но на ревью могут спросить, решай сам.
DELETE {{baseUrl}}/profile/my/avatars/{{foreign_avatar_id}}
Authorization: Bearer {{del_access_token}}

> {%
    client.test("чужая аватарка = 403", function () {
        client.assert(response.status === 403, "ожидали 403, пришло " + response.status);
    });
%}


# ─────────────────────────────────────────────────────────────────────────────
# СЧАСТЛИВЫЙ ПУТЬ — ожидаем 204
# ─────────────────────────────────────────────────────────────────────────────

### Владелец удаляет свою аватарку — ожидаем 204 без тела
DELETE {{baseUrl}}/profile/my/avatars/{{own_avatar_id}}
Authorization: Bearer {{del_access_token}}

> {%
    client.test("своя аватарка удалена = 204", function () {
        client.assert(response.status === 204, "ожидали 204, пришло " + response.status);
    });
    client.test("тело пустое", function () {
        client.assert(!response.body, "у 204 не должно быть тела, пришло " + response.body);
    });
%}


### Та же аватарка ещё раз — ожидаем 404
# Удалённая мягко запись для findOneBy уже не существует.
DELETE {{baseUrl}}/profile/my/avatars/{{own_avatar_id}}
Authorization: Bearer {{del_access_token}}

> {%
    client.test("повторное удаление = 404", function () {
        client.assert(response.status === 404, "ожидали 404, пришло " + response.status);
    });
%}


### Чужой удаляет свою аватарку — ожидаем 204
# Заодно доказывает, что попытка владельца с 403 выше её не удалила.
DELETE {{baseUrl}}/profile/my/avatars/{{foreign_avatar_id}}
Authorization: Bearer {{del_other_access_token}}

> {%
    client.test("чужой удалил свою = 204", function () {
        client.assert(response.status === 204, "ожидали 204, пришло " + response.status);
    });
%}


# ─────────────────────────────────────────────────────────────────────────────
# КРИВОЙ ID — ожидаем 400 от IdParamDto, до базы запрос не доходит.
# id должен быть целым от 1 до 2147483647 (максимум integer в Postgres).
# ─────────────────────────────────────────────────────────────────────────────

### Не число — ожидаем 400
DELETE {{baseUrl}}/profile/my/avatars/abc
Authorization: Bearer {{del_access_token}}

> {%
    client.test("id = abc → 400", function () {
        client.assert(response.status === 400, "ожидали 400, пришло " + response.status);
    });
%}


### Дробное число — ожидаем 400
DELETE {{baseUrl}}/profile/my/avatars/1.5
Authorization: Bearer {{del_access_token}}

> {%
    client.test("id = 1.5 → 400", function () {
        client.assert(response.status === 400, "ожидали 400, пришло " + response.status);
    });
%}


### Ноль — ожидаем 400 (@Min(1))
DELETE {{baseUrl}}/profile/my/avatars/0
Authorization: Bearer {{del_access_token}}

> {%
    client.test("id = 0 → 400", function () {
        client.assert(response.status === 400, "ожидали 400, пришло " + response.status);
    });
%}


### Отрицательное число — ожидаем 400 (@Min(1))
DELETE {{baseUrl}}/profile/my/avatars/-1
Authorization: Bearer {{del_access_token}}

> {%
    client.test("id = -1 → 400", function () {
        client.assert(response.status === 400, "ожидали 400, пришло " + response.status);
    });
%}


### Максимальный integer — id корректный, но такой аватарки нет — ожидаем 404
# Граница: сюда DTO ещё пропускает, запрос доходит до базы и не падает.
DELETE {{baseUrl}}/profile/my/avatars/2147483647
Authorization: Bearer {{del_access_token}}

> {%
    client.test("id = 2147483647 → 404", function () {
        client.assert(response.status === 404, "ожидали 404, пришло " + response.status);
    });
%}


### На единицу больше integer — ожидаем 400 (@Max), а не 500
# Колонка id — SERIAL, то есть integer, максимум 2147483647. Раньше
# ParseIntPipe такое число пропускал, Postgres падал с "value out of range
# for type integer", и наружу уходил 500. Теперь DTO отсекает его на входе.
DELETE {{baseUrl}}/profile/my/avatars/2147483648
Authorization: Bearer {{del_access_token}}

> {%
    client.test("id больше integer → 400", function () {
        client.assert(response.status === 400, "ожидали 400, пришло " + response.status);
    });
%}


# ─────────────────────────────────────────────────────────────────────────────
# ЛИМИТ — удаление освобождает место под новую аватарку
# У владельца сейчас 0 активных и 1 удалённая. Если все пять загрузок ниже
# проходят, удалённая в лимит не считается.
# ─────────────────────────────────────────────────────────────────────────────

### Слот 1 из 5
POST {{baseUrl}}/profile/my/avatars
Authorization: Bearer {{del_access_token}}
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="avatar"; filename="avatar.png"
Content-Type: image/png

< ./fixtures/avatar.png
--boundary--

> {%
    client.test("слот 1 = 201", function () {
        client.assert(response.status === 201, "ожидали 201, пришло " + response.status);
    });
%}


