# ═════════════════════════════════════════════════════════════════════════════
# МЯГКОЕ УДАЛЕНИЕ — в самом конце, после него токены пользователя мертвы
# ═════════════════════════════════════════════════════════════════════════════

### Удалить свой аккаунт — 204 без тела
DELETE {{baseUrl}}/profile/my
Authorization: Bearer {{prof_access}}

> {%
    client.test("204 No Content", () => client.assert(response.status === 204, `пришло ${response.status}`));
    client.test("тело пустое", () => client.assert(!response.body, `пришло ${response.body}`));
%}


### Профиль после удаления — 401
# Гвард на каждом запросе ищет пользователя в базе, удалённого не находит.
GET {{baseUrl}}/profile/my
Authorization: Bearer {{prof_access}}

> {%
    client.test("401 Unauthorized", () => client.assert(response.status === 401, `пришло ${response.status}`));
    client.test("сообщение про пользователя", () => client.assert(response.body.message === "User not found", response.body.message));
%}


### Refresh после удаления — 401, сессии отозваны
POST {{baseUrl}}/auth/refresh
Content-Type: application/json

{
  "refresh_token": "{{prof_refresh}}"
}

> {%
    client.test("401 Unauthorized", () => client.assert(response.status === 401, `пришло ${response.status}`));
%}


