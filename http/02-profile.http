# ═════════════════════════════════════════════════════════════════════════════
# СМЕНА ПАРОЛЯ — завершает все сессии, включая текущую
# ═════════════════════════════════════════════════════════════════════════════

### Сменить пароль — 200
PATCH {{baseUrl}}/profile/my
Authorization: Bearer {{prof_access}}
Content-Type: application/json

{
  "password": "{{password}}_new"
}

> {%
    client.test("200 OK", () => client.assert(response.status === 200, `пришло ${response.status}`));
    client.test("пароль в ответ не попал", () => client.assert(!("password" in response.body), "в ответе есть password"));
%}


### Access, выданный до смены пароля — 401
# Токен не истёк и подпись верная, но tokenVersion в нём уже старый.
GET {{baseUrl}}/profile/my
Authorization: Bearer {{prof_access}}

> {%
    client.test("401 Unauthorized", () => client.assert(response.status === 401, `пришло ${response.status} — старые сессии не отозваны`));
    client.test("сообщение про отозванную сессию", () => {
        client.assert(response.body.message === "Session has been revoked", response.body.message);
    });
%}


### Refresh, выданный до смены пароля — 401
POST {{baseUrl}}/auth/refresh
Content-Type: application/json

{
  "refresh_token": "{{prof_refresh}}"
}

> {%
    client.test("401 Unauthorized", () => client.assert(response.status === 401, `пришло ${response.status}`));
%}


