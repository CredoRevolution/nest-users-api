###############################################################################
# PROFILE — /profile/my: чтение, JwtAuthGuard, обновление, смена пароля,
# мягкое удаление.
#
# Самодостаточный: создаёт своих пользователей с уникальными логинами.
# Запуск — сверху вниз, блоки со сменой пароля и удалением зависят от порядка.
###############################################################################

### Основной пользователь
# @name Основной пользователь
< {%
    const login = "prof_" + Date.now();
    request.variables.set("login", login);
    client.global.set("prof_login", login);
%}
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "login": "{{login}}",
  "email": "{{login}}@example.com",
  "password": "{{password}}",
  "age": 28,
  "about": "основной пользователь profile-тестов"
}

> {%
    client.test("201 Created", () => client.assert(response.status === 201, `пришло ${response.status}`));
    client.global.set("prof_access", response.body.access_token);
    client.global.set("prof_refresh", response.body.refresh_token);
%}


### Второй пользователь — его логин и email попробуем занять
# @name Второй пользователь
< {%
    const login = "prof2_" + Date.now();
    request.variables.set("login", login);
    client.global.set("prof_other_login", login);
%}
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "login": "{{login}}",
  "email": "{{login}}@example.com",
  "password": "{{password}}",
  "age": 27
}

> {%
    client.test("201 Created", () => client.assert(response.status === 201, `пришло ${response.status}`));
    client.global.set("prof_other_access", response.body.access_token);
%}


# ═════════════════════════════════════════════════════════════════════════════
# ЧТЕНИЕ
# ═════════════════════════════════════════════════════════════════════════════

### Свой профиль — 200
GET {{baseUrl}}/profile/my
Authorization: Bearer {{prof_access}}

> {%
    client.test("200 OK", () => client.assert(response.status === 200, `пришло ${response.status}`));
    client.test("все поля профиля на месте", () => {
        const body = response.body;
        client.assert(body.login === client.global.get("prof_login"), `login = ${body.login}`);
        client.assert(body.email === `${client.global.get("prof_login")}@example.com`, `email = ${body.email}`);
        client.assert(body.age === 28, `age = ${body.age}`);
        client.assert(body.about === "основной пользователь profile-тестов", `about = ${body.about}`);
        client.assert(Number.isInteger(body.id), `id = ${body.id}`);
    });
    client.test("служебные поля наружу не уходят", () => {
        for (const field of ["password", "passwordHash", "tokenVersion", "deletedAt"]) {
            client.assert(!(field in response.body), `в ответе есть ${field}`);
        }
    });

    client.global.set("prof_id", String(response.body.id));
%}


### Профиль по токену второго — другой пользователь
# id берётся из токена, а не откуда-то ещё.
GET {{baseUrl}}/profile/my
Authorization: Bearer {{prof_other_access}}

> {%
    client.test("200 OK", () => client.assert(response.status === 200, `пришло ${response.status}`));
    client.test("пришёл второй пользователь", () => {
        client.assert(response.body.login === client.global.get("prof_other_login"), `login = ${response.body.login}`);
    });
%}


# ─────────────────────────────────────────────────────────────────────────────
# JwtAuthGuard — всё это 401
# ─────────────────────────────────────────────────────────────────────────────

### Без заголовка Authorization — 401
GET {{baseUrl}}/profile/my

> {%
    client.test("401 Unauthorized", () => client.assert(response.status === 401, `пришло ${response.status}`));
    client.test("сообщение про отсутствующий токен", () => {
        client.assert(response.body.message === "Access token is required", response.body.message);
    });
%}


### Пустой Authorization — 401
GET {{baseUrl}}/profile/my
Authorization:

> {%
    client.test("401 Unauthorized", () => client.assert(response.status === 401, `пришло ${response.status}`));
%}


### Токен без слова Bearer — 401
GET {{baseUrl}}/profile/my
Authorization: {{prof_access}}

> {%
    client.test("401 Unauthorized", () => client.assert(response.status === 401, `пришло ${response.status}`));
%}


### Схема Basic вместо Bearer — 401
GET {{baseUrl}}/profile/my
Authorization: Basic {{prof_access}}

> {%
    client.test("401 Unauthorized", () => client.assert(response.status === 401, `пришло ${response.status}`));
%}


### Схема строчными буквами — 401
# Сравнение в extractTokenFromHeader регистрозависимое. По RFC 7235 схема
# регистронезависима, так что клиент с «bearer» формально прав.
GET {{baseUrl}}/profile/my
Authorization: bearer {{prof_access}}

> {%
    client.test("401 Unauthorized", () => client.assert(response.status === 401, `пришло ${response.status}`));
%}


### Мусор вместо токена — 401
GET {{baseUrl}}/profile/my
Authorization: Bearer это-не-токен

> {%
    client.test("401 Unauthorized", () => client.assert(response.status === 401, `пришло ${response.status}`));
%}


### Выдуманная подпись — 401
GET {{baseUrl}}/profile/my
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOjEsImxvZ2luIjoic2FzaGEiLCJpYXQiOjE3MDAwMDAwMDAsImV4cCI6MTgwMDAwMDAwMH0.podpis-vydumana-i-ne-soydyotsya

> {%
    client.test("401 Unauthorized", () => client.assert(response.status === 401, `пришло ${response.status}`));
%}


### Refresh-токен вместо access — 401
GET {{baseUrl}}/profile/my
Authorization: Bearer {{prof_refresh}}

> {%
    client.test("401 Unauthorized", () => client.assert(response.status === 401, `пришло ${response.status}`));
%}


# ═════════════════════════════════════════════════════════════════════════════
# ОБНОВЛЕНИЕ
# ═════════════════════════════════════════════════════════════════════════════

### Обновить about — 200, остальные поля не тронуты
PATCH {{baseUrl}}/profile/my
Authorization: Bearer {{prof_access}}
Content-Type: application/json

{
  "about": "обновлённое описание"
}

> {%
    client.test("200 OK", () => client.assert(response.status === 200, `пришло ${response.status}`));
    client.test("about обновился", () => client.assert(response.body.about === "обновлённое описание", response.body.about));
    client.test("остальное как было", () => {
        client.assert(response.body.login === client.global.get("prof_login"), `login = ${response.body.login}`);
        client.assert(response.body.age === 28, `age = ${response.body.age}`);
    });
    client.test("служебные поля наружу не уходят", () => {
        for (const field of ["passwordHash", "tokenVersion", "deletedAt"]) {
            client.assert(!(field in response.body), `в ответе есть ${field}`);
        }
    });
%}


### Обновить возраст — 200
PATCH {{baseUrl}}/profile/my
Authorization: Bearer {{prof_access}}
Content-Type: application/json

{
  "age": 29
}

> {%
    client.test("200 OK", () => client.assert(response.status === 200, `пришло ${response.status}`));
    client.test("age обновился", () => client.assert(response.body.age === 29, `age = ${response.body.age}`));
%}


### Изменения сохранились в базе
GET {{baseUrl}}/profile/my
Authorization: Bearer {{prof_access}}

> {%
    client.test("about и age из базы новые", () => {
        client.assert(response.body.about === "обновлённое описание", `about = ${response.body.about}`);
        client.assert(response.body.age === 29, `age = ${response.body.age}`);
    });
%}


### Пустое тело — 200, ничего не меняется
PATCH {{baseUrl}}/profile/my
Authorization: Bearer {{prof_access}}
Content-Type: application/json

{}

> {%
    client.test("200 OK", () => client.assert(response.status === 200, `пришло ${response.status}`));
    client.test("данные прежние", () => client.assert(response.body.age === 29, `age = ${response.body.age}`));
%}


### Свой же логин — 200, это не конфликт
