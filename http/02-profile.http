### Удалённый не виден через /users/:id — 404
GET {{baseUrl}}/users/{{prof_id}}
Authorization: Bearer {{prof_other_access}}

> {%
    client.test("404 Not Found", () => client.assert(response.status === 404, `пришло ${response.status}`));
%}


### Регистрация с логином удалённого — 409
# Строка в таблице осталась, existsByLogin ищет с withDeleted: true.
# Логин и email заняты навсегда.
# @name Регистрация с логином удалённого
< {%
    request.variables.set("email", "reuse_" + Date.now() + "@example.com");
%}
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "login": "{{prof_login}}",
  "email": "{{email}}",
  "password": "{{password}}",
  "age": 28
}

> {%
    client.test("409 Conflict", () => client.assert(response.status === 409, `пришло ${response.status}`));
%}


### Регистрация с email удалённого — 409
# @name Регистрация с email удалённого
< {%
    request.variables.set("login", "reuse_" + Date.now());
%}
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "login": "{{login}}",
  "email": "{{prof_login}}@example.com",
  "password": "{{password}}",
  "age": 28
}

> {%
    client.test("409 Conflict", () => client.assert(response.status === 409, `пришло ${response.status}`));
%}
