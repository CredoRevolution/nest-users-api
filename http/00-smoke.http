###############################################################################
# SMOKE — счастливый путь целиком: регистрация → профиль → refresh → ротация.
#
# Запуск: кнопка «Run all requests in file» в шапке. Все зелёные — база живая.
# Файл самодостаточный: каждый прогон создаёт нового пользователя.
###############################################################################

### Регистрация
# @name Регистрация
< {%
    const login = "smoke_" + Date.now();
    request.variables.set("login", login);
    client.global.set("smoke_login", login);
%}
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "login": "{{login}}",
  "email": "{{login}}@example.com",
  "password": "{{password}}",
  "age": 30,
  "about": "пользователь для smoke-прогона"
}

> {%
    client.test("201 Created", () => client.assert(response.status === 201, `пришло ${response.status}`));
    client.test("в ответе оба токена", () => {
        client.assert(typeof response.body.access_token === "string", "нет access_token");
        client.assert(typeof response.body.refresh_token === "string", "нет refresh_token");
    });

    client.global.set("smoke_access", response.body.access_token);
    client.global.set("smoke_refresh", response.body.refresh_token);
%}


### Профиль по свежему access-токену
GET {{baseUrl}}/profile/my
Authorization: Bearer {{smoke_access}}

> {%
    client.test("200 OK", () => client.assert(response.status === 200, `пришло ${response.status}`));
    client.test("это тот, кого зарегистрировали", () => {
        client.assert(response.body.login === client.global.get("smoke_login"), `login = ${response.body.login}`);
    });
    client.test("служебные поля наружу не уходят", () => {
        for (const field of ["passwordHash", "tokenVersion", "deletedAt"]) {
            client.assert(!(field in response.body), `в ответе есть ${field}`);
        }
    });
%}


### Обмен refresh на новую пару
POST {{baseUrl}}/auth/refresh
Content-Type: application/json

{
  "refresh_token": "{{smoke_refresh}}"
}

> {%
    const oldRefresh = client.global.get("smoke_refresh");

    client.test("200 OK", () => client.assert(response.status === 200, `пришло ${response.status}`));
    client.test("refresh-токен новый", () => {
        client.assert(response.body.refresh_token !== oldRefresh, "вернулся тот же refresh — ротации нет");
    });

    client.global.set("smoke_old_refresh", oldRefresh);
    client.global.set("smoke_access", response.body.access_token);
    client.global.set("smoke_refresh", response.body.refresh_token);
%}


### Профиль по новому access-токену
GET {{baseUrl}}/profile/my
Authorization: Bearer {{smoke_access}}

> {%
    client.test("200 OK", () => client.assert(response.status === 200, `пришло ${response.status}`));
%}


### Старый refresh повторно — 401
# Доказательство ротации: использованный токен удалён из refresh_tokens.
# Побочный эффект: повтор считается кражей, и сервер отзывает все refresh
# пользователя, поэтому запрос последний.
POST {{baseUrl}}/auth/refresh
Content-Type: application/json

{
  "refresh_token": "{{smoke_old_refresh}}"
}

> {%
    client.test("401 Unauthorized", () => client.assert(response.status === 401, `пришло ${response.status} — ротация не работает`));
%}
