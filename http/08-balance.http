### Итог: у A и B суммарно ровно 110, сколько и вносили
GET {{baseUrl}}/profile/my/balance
Authorization: Bearer {{bal_a_access}}

> {%
    client.test("balance A = 90", () => client.assert(response.body.balance === 90, `balance = ${response.body.balance}`));
%}


### Баланс B
GET {{baseUrl}}/profile/my/balance
Authorization: Bearer {{bal_b_access}}

> {%
    client.test("balance B = 20, в сумме 110", () => {
        client.assert(response.body.balance === 20, `balance = ${response.body.balance}`);
    });
%}
