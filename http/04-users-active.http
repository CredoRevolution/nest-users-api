###############################################################################
# ACTIVE USERS — GET /users/active?minAge=&maxAge=
#
# Активный пользователь: не удалён, about не пустой, больше двух
# неудалённых аватарок. В ответе id, login, avatarsCount, latestAvatar.
# По умолчанию minAge = 1, maxAge = 150, границы включительно.
# Роут не кэшируется.
#
# Самодостаточный, но грузит аватарки — нужен MinIO и бакет (см. README).
# Все пользователи файла одного случайного возраста {{act_age}}:
#   A — about есть, 3 аватарки          → активный
#   B — about нет, 3 аватарки           → нет
#   C — about пустая строка, 3 аватарки → нет
#   D — about есть, 2 аватарки          → нет, пока не загрузит третью
###############################################################################

### A — регистрация
# @name A — регистрация
< {%
    const prefix = "act" + Date.now();
    const age = String(40 + Math.floor(Math.random() * 100));
    client.global.set("act_prefix", prefix);
    client.global.set("act_age", age);
    request.variables.set("login", prefix + "_a");
    request.variables.set("age", age);
%}
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "login": "{{login}}",
  "email": "{{login}}@example.com",
  "password": "{{password}}",
  "age": {{age}},
  "about": "активный"
}

> {%
    client.test("201 Created", () => client.assert(response.status === 201, `пришло ${response.status}`));
    client.global.set("act_a_access", response.body.access_token);
%}


### A — аватарка 1
POST {{baseUrl}}/profile/my/avatars
Authorization: Bearer {{act_a_access}}
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="avatar"; filename="avatar.png"
Content-Type: image/png

< ./fixtures/avatar.png
--boundary--

> {%
    client.test("201 Created", () => client.assert(response.status === 201, `пришло ${response.status}`));
    client.global.set("act_a_first_avatar_id", String(response.body.id));
%}


