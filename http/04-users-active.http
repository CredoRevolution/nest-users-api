# ═════════════════════════════════════════════════════════════════════════════
# КТО АКТИВЕН
# ═════════════════════════════════════════════════════════════════════════════

### Ровно наш возраст — из наших активен только A
GET {{baseUrl}}/users/active?minAge={{act_age}}&maxAge={{act_age}}
Authorization: Bearer {{act_a_access}}

> {%
    const prefix = client.global.get("act_prefix");
    const ours = response.body.filter(user => user.login.startsWith(prefix));

    client.test("200 OK", () => client.assert(response.status === 200, `пришло ${response.status}`));
    client.test("из наших только A", () => {
        const logins = ours.map(user => user.login);
        client.assert(JSON.stringify(logins) === JSON.stringify([`${prefix}_a`]), `пришло ${logins}`);
    });
    client.test("у A 3 аватарки и последняя — jpg", () => {
        const a = ours[0];
        client.assert(a.avatarsCount === 3, `avatarsCount = ${a.avatarsCount}`);
        client.assert(a.latestAvatar === client.global.get("act_a_latest"), `latestAvatar = ${a.latestAvatar}`);
    });
    client.test("в ответе только id, login, avatarsCount, latestAvatar", () => {
        for (const user of response.body) {
            for (const field of ["id", "login", "avatarsCount", "latestAvatar"]) {
                client.assert(field in user, `у ${user.login} нет ${field}`);
            }
            for (const field of ["email", "passwordHash", "tokenVersion", "deletedAt"]) {
                client.assert(!(field in user), `у ${user.login} есть ${field}`);
            }
        }
    });
    client.test("у всех больше двух аватарок", () => {
        for (const user of response.body) {
            client.assert(user.avatarsCount > 2, `у ${user.login} avatarsCount = ${user.avatarsCount}`);
        }
    });
%}


### Без параметров (1..150) — A тоже есть
GET {{baseUrl}}/users/active
Authorization: Bearer {{act_a_access}}

> {%
    client.test("200 OK", () => client.assert(response.status === 200, `пришло ${response.status}`));
    client.test("A в списке", () => {
        client.assert(response.body.some(user => user.login === `${client.global.get("act_prefix")}_a`), "A не нашёлся");
    });
    client.test("нет X-Cache — роут не кэшируется", () => {
        client.assert(response.headers.valueOf("X-Cache") == null, `X-Cache = ${response.headers.valueOf("X-Cache")}`);
    });
%}


### minAge на год больше — A нет
# @name minAge на год больше
< {%
    request.variables.set("age", String(Number(client.global.get("act_age")) + 1));
%}
GET {{baseUrl}}/users/active?minAge={{age}}
Authorization: Bearer {{act_a_access}}

> {%
    client.test("200 OK", () => client.assert(response.status === 200, `пришло ${response.status}`));
    client.test("A нет", () => {
        client.assert(!response.body.some(user => user.login === `${client.global.get("act_prefix")}_a`), "A в списке");
    });
%}


### maxAge на год меньше — A нет
# @name maxAge на год меньше
< {%
    request.variables.set("age", String(Number(client.global.get("act_age")) - 1));
%}
GET {{baseUrl}}/users/active?maxAge={{age}}
Authorization: Bearer {{act_a_access}}

> {%
    client.test("200 OK", () => client.assert(response.status === 200, `пришло ${response.status}`));
    client.test("A нет", () => {
        client.assert(!response.body.some(user => user.login === `${client.global.get("act_prefix")}_a`), "A в списке");
    });
%}


### minAge больше maxAge — пустой массив, не ошибка
# Перекрёстной проверки в DTO нет, а BETWEEN 50 AND 20 просто ничего не находит.
GET {{baseUrl}}/users/active?minAge=50&maxAge=20
Authorization: Bearer {{act_a_access}}

> {%
    client.test("200 OK", () => client.assert(response.status === 200, `пришло ${response.status}`));
    client.test("пусто", () => client.assert(response.body.length === 0, `пришло ${response.body.length}`));
%}


