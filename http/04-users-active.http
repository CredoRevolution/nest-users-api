### Пустое значение — 400
# ?minAge= приходит пустой строкой, Number('') = 0, срабатывает @Min(1).
GET {{baseUrl}}/users/active?minAge=
Authorization: Bearer {{act_d_access}}

> {%
    client.test("400 Bad Request", () => client.assert(response.status === 400, `пришло ${response.status}`));
%}


### Больше integer — 400 (@Max(150) отсекает раньше базы)
GET {{baseUrl}}/users/active?minAge=2147483648
Authorization: Bearer {{act_d_access}}

> {%
    client.test("400 Bad Request", () => client.assert(response.status === 400, `пришло ${response.status}`));
%}


### Попытка SQL-инъекции — 400 от валидации, до базы не доходит
# Значение: 1 OR 1=1
GET {{baseUrl}}/users/active?minAge=1%20OR%201%3D1
Authorization: Bearer {{act_d_access}}

> {%
    client.test("400 Bad Request", () => client.assert(response.status === 400, `пришло ${response.status}`));
%}


