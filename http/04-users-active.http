### A удаляет одну аватарку — у него остаётся две
DELETE {{baseUrl}}/profile/my/avatars/{{act_a_first_avatar_id}}
Authorization: Bearer {{act_a_access}}

> {%
    client.test("204 No Content", () => client.assert(response.status === 204, `пришло ${response.status}`));
%}


### Теперь активен D, а A — нет
GET {{baseUrl}}/users/active?minAge={{act_age}}&maxAge={{act_age}}
Authorization: Bearer {{act_a_access}}

> {%
    const prefix = client.global.get("act_prefix");
    const logins = response.body.map(user => user.login).filter(login => login.startsWith(prefix));

    client.test("200 OK", () => client.assert(response.status === 200, `пришло ${response.status}`));
    client.test("из наших только D", () => {
        client.assert(JSON.stringify(logins) === JSON.stringify([`${prefix}_d`]), `пришло ${logins}`);
    });
%}


