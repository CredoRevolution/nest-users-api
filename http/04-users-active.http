### A снова активен, latestAvatar — новая, удалённая в подсчёт не вошла
GET {{baseUrl}}/users/active?minAge={{act_age}}&maxAge={{act_age}}
Authorization: Bearer {{act_a_access}}

> {%
    const a = response.body.find(user => user.login === `${client.global.get("act_prefix")}_a`);

    client.test("200 OK", () => client.assert(response.status === 200, `пришло ${response.status}`));
    client.test("A в списке", () => client.assert(a, "A не нашёлся"));
    client.test("avatarsCount = 3, latestAvatar — новая", () => {
        client.assert(a.avatarsCount === 3, `avatarsCount = ${a.avatarsCount}`);
        client.assert(a.latestAvatar === client.global.get("act_a_latest"), `latestAvatar = ${a.latestAvatar}`);
    });
%}


