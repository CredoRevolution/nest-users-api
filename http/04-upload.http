###############################################################################
# UPLOAD — POST /test-upload: принимает ОДНУ картинку (png, jpeg, webp)
# в поле "file" и кладёт её в MinIO через IFileService.
#
# Перед запуском:
#   docker compose up -d            — поднимется и MinIO
#   в .env есть S3_ENDPOINT, S3_BUCKET_NAME, MINIO_ACCESS_KEY, MINIO_SECRET_KEY
#   бакет из S3_BUCKET_NAME создан в консоли MinIO: http://localhost:9001
#
# Картинки лежат в http/fixtures. Пути в запросах считаются от этого файла.
#
# Тип файла проверяется по содержимому (magic numbers), а не по расширению
# и не по Content-Type части: и то, и другое клиент пишет что захочет.
# Ответ успешной загрузки: { "path": "test-folder/<uuid>.<расширение>" }.
#
# Токен не нужен: гварда на эндпоинте нет.
###############################################################################

### PNG — ожидаем 201 и путь в бакете
POST {{baseUrl}}/test-upload
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="file"; filename="avatar.png"
Content-Type: image/png

< ./fixtures/avatar.png
--boundary--

> {%
    client.test("png загружен = 201", function () {
        client.assert(response.status === 201, "ожидали 201, пришло " + response.status);
    });
    client.test("в ответе путь с .png", function () {
        client.assert(response.body && /\.png$/.test(response.body.path),
            "ожидали path вида test-folder/<uuid>.png, пришло " + JSON.stringify(response.body));
    });
%}


