### Одна и та же картинка дважды — пути должны быть РАЗНЫЕ
# Если имя в бакете берётся из чего-то постоянного (или из undefined),
# вторая загрузка молча затрёт первую.
POST {{baseUrl}}/test-upload
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="file"; filename="avatar.png"
Content-Type: image/png

< ./fixtures/avatar.png
--boundary--

> {%
    client.global.set("first_upload_path", response.body && response.body.path);
%}

###
POST {{baseUrl}}/test-upload
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="file"; filename="avatar.png"
Content-Type: image/png

< ./fixtures/avatar.png
--boundary--

> {%
    client.test("вторая загрузка не затёрла первую", function () {
        const first = client.global.get("first_upload_path");
        const second = response.body && response.body.path;
        client.assert(first && second && first !== second,
            "пути совпали или пустые: " + first + " и " + second);
    });
%}


### Расширение и Content-Type врут, а внутри настоящий PNG — ожидаем 201
# Решает содержимое. Сохранится как .png, а не .jpg, как заявил клиент.
POST {{baseUrl}}/test-upload
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="file"; filename="photo.jpg"
Content-Type: image/jpeg

< ./fixtures/avatar.png
--boundary--

> {%
    client.test("настоящий png под видом jpg = 201", function () {
        client.assert(response.status === 201, "ожидали 201, пришло " + response.status);
    });
    client.test("сохранён по реальному типу, как .png", function () {
        client.assert(response.body && /\.png$/.test(response.body.path),
            "ожидали .png, пришло " + JSON.stringify(response.body));
    });
%}


# ─────────────────────────────────────────────────────────────────────────────
# НЕ КАРТИНКИ И НЕРАЗРЕШЁННЫЕ ФОРМАТЫ — ожидаем 400
# ─────────────────────────────────────────────────────────────────────────────

### Обычный текстовый файл — ожидаем 400
POST {{baseUrl}}/test-upload
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="file"; filename="hello.txt"
Content-Type: text/plain

Привет, это не картинка.
--boundary--

> {%
    client.test("текст = 400", function () {
        client.assert(response.status === 400, "ожидали 400, пришло " + response.status);
    });
%}


### Текст, притворяющийся PNG (расширение .png, Content-Type image/png) — ожидаем 400
# Главный тест: если здесь 201, значит тип проверяется по заголовку от клиента,
# а его подделать проще простого.
POST {{baseUrl}}/test-upload
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="file"; filename="fake.png"
Content-Type: image/png

< ./fixtures/fake.png
--boundary--

> {%
    client.test("подделка под png = 400", function () {
        client.assert(response.status === 400, "ожидали 400, пришло " + response.status);
    });
%}


### GIF — настоящая картинка, но формат не разрешён — ожидаем 400
