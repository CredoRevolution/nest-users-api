# ─────────────────────────────────────────────────────────────────────────────
# РУЧНЫЕ ПРОВЕРКИ
# ─────────────────────────────────────────────────────────────────────────────

### Слишком большая картинка — ожидаем 413
# Как проверить: положи любую фотку больше 5 МБ в http/fixtures/big.jpg
# (в git её не коммить). Лимит стоит в multer, поэтому гигабайтный файл
# отсекается ещё на приёме, а не после того, как целиком лёг в память.
POST {{baseUrl}}/test-upload
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="file"; filename="big.jpg"
Content-Type: image/jpeg

< ./fixtures/big.jpg
--boundary--

> {%
    client.test("больше лимита = 413", function () {
        client.assert(response.status === 413, "ожидали 413, пришло " + response.status);
    });
%}


### MinIO лежит — ожидаем 400 (UploadException)
# Как проверить: docker compose stop minio, выполни запрос, потом
# docker compose start minio. SDK сначала сделает несколько повторов,
# поэтому ответ придёт не сразу. UploadException наследует BadRequestException,
# отсюда 400, а не 502/503 — решай сам, устраивает ли это.
POST {{baseUrl}}/test-upload
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="file"; filename="avatar.png"
Content-Type: image/png

< ./fixtures/avatar.png
--boundary--
