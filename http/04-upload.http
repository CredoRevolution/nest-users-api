### SVG — ожидаем 400
# SVG — это XML, внутри может быть <script>. Раздавать такое из бакета
# с public-read — готовый XSS. Поэтому для аватарок SVG не принимаем.
POST {{baseUrl}}/test-upload
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="file"; filename="avatar.svg"
Content-Type: image/svg+xml

<svg xmlns="http://www.w3.org/2000/svg" width="10" height="10"><script>alert(1)</script></svg>
--boundary--

> {%
    client.test("svg = 400", function () {
        client.assert(response.status === 400, "ожидали 400, пришло " + response.status);
    });
%}


