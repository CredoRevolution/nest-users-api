# ─────────────────────────────────────────────────────────────────────────────
# КРИВОЙ MULTIPART — ожидаем 400, до S3 дело не доходит
# ─────────────────────────────────────────────────────────────────────────────

### Картинка в поле с другим именем — ожидаем 400 (Unexpected field)
# FileInterceptor ждёт ровно поле "file".
POST {{baseUrl}}/test-upload
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="avatar"; filename="avatar.png"
Content-Type: image/png

< ./fixtures/avatar.png
--boundary--

> {%
    client.test("чужое имя поля = 400", function () {
        client.assert(response.status === 400, "ожидали 400, пришло " + response.status);
    });
%}


### Две картинки в поле "file" — ожидаем 400
# FileInterceptor = multer.single(): второй файл в том же поле уже лишний.
POST {{baseUrl}}/test-upload
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="file"; filename="first.png"
Content-Type: image/png

< ./fixtures/avatar.png
--boundary
Content-Disposition: form-data; name="file"; filename="second.jpg"
Content-Type: image/jpeg

< ./fixtures/avatar.jpg
--boundary--

> {%
    client.test("две картинки вместо одной = 400", function () {
        client.assert(response.status === 400, "ожидали 400, пришло " + response.status);
    });
%}


### Multipart без файла, только текстовое поле — ожидаем 400
POST {{baseUrl}}/test-upload
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="description"

файла нет
--boundary--

> {%
    client.test("multipart без файла = 400", function () {
        client.assert(response.status === 400, "ожидали 400, пришло " + response.status);
    });
%}


### JSON вместо multipart — ожидаем 400
# multer пропускает не-multipart запросы мимо себя, файл просто не появляется.
POST {{baseUrl}}/test-upload
Content-Type: application/json

{
  "file": "это строка, а не файл"
}

> {%
    client.test("JSON вместо файла = 400", function () {
        client.assert(response.status === 400, "ожидали 400, пришло " + response.status);
    });
%}


