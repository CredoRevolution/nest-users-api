### Слот 5 из 5 — проходит, удалённая место не заняла
POST {{baseUrl}}/profile/my/avatars
Authorization: Bearer {{del_access}}
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="avatar"; filename="avatar.png"
Content-Type: image/png

< ./fixtures/avatar.png
--boundary--

> {%
    client.test("201 Created", () => client.assert(response.status === 201, `пришло ${response.status}`));
    client.global.set("del_last_id", String(response.body.id));
%}


### Шестая — 409
POST {{baseUrl}}/profile/my/avatars
Authorization: Bearer {{del_access}}
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="avatar"; filename="avatar.png"
Content-Type: image/png

< ./fixtures/avatar.png
--boundary--

> {%
    client.test("409 Conflict", () => client.assert(response.status === 409, `пришло ${response.status}`));
%}


### Удаляем одну — 204
DELETE {{baseUrl}}/profile/my/avatars/{{del_last_id}}
Authorization: Bearer {{del_access}}

> {%
    client.test("204 No Content", () => client.assert(response.status === 204, `пришло ${response.status}`));
%}


### Снова шестая — место освободилось, 201
POST {{baseUrl}}/profile/my/avatars
Authorization: Bearer {{del_access}}
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="avatar"; filename="avatar.png"
Content-Type: image/png

< ./fixtures/avatar.png
--boundary--

> {%
    client.test("201 Created", () => client.assert(response.status === 201, `пришло ${response.status}`));
%}
