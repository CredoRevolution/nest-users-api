### Та же картинка ещё раз — новая запись, новое имя
# Аватарок у пользователя может быть много (ManyToOne), старая не должна
# затираться ни в таблице, ни в бакете.
POST {{baseUrl}}/profile/my/avatars
Authorization: Bearer {{avatar_access_token}}
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="avatar"; filename="avatar.png"
Content-Type: image/png

< ./fixtures/avatar.png
--boundary--

> {%
    client.test("повторная загрузка = 201", function () {
        client.assert(response.status === 201, "ожидали 201, пришло " + response.status);
    });
    client.test("новая запись, а не перезапись старой", function () {
        client.assert(response.body.id !== client.global.get("first_avatar_id"),
            "id совпал с первой загрузкой");
        client.assert(response.body.name !== client.global.get("first_avatar_name"),
            "имя совпало с первой загрузкой — файл в бакете затёрт");
    });
%}


### Расширение и Content-Type врут, а внутри настоящий PNG — ожидаем 201
# Решает содержимое. Сохранится как .png, а не .jpg, как заявил клиент.
POST {{baseUrl}}/profile/my/avatars
Authorization: Bearer {{avatar_access_token}}
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="avatar"; filename="photo.jpg"
Content-Type: image/jpeg

< ./fixtures/avatar.png
--boundary--

> {%
    client.test("настоящий png под видом jpg = 201", function () {
        client.assert(response.status === 201, "ожидали 201, пришло " + response.status);
    });
    client.test("сохранён по реальному типу, как .png", function () {
        client.assert(/\.png$/.test(response.body.name),
            "ожидали .png, пришло " + response.body.name);
    });
%}


