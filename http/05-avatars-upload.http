###############################################################################
# AVATARS — POST /profile/my/avatars: загрузка аватарки текущего пользователя.
# Одна картинка (png или jpeg) в поле "avatar", файл уходит в MinIO,
# в таблицу avatars пишется запись { id, name, userId, createdAt }.
#
# Перед запуском:
#   docker compose up -d            — поднимется и MinIO
#   в .env есть S3_ENDPOINT, S3_BUCKET_NAME, MINIO_ACCESS_KEY, MINIO_SECRET_KEY
#   бакет из S3_BUCKET_NAME создан в консоли MinIO: http://localhost:9001
#
# Файл самодостаточный: первым запросом регистрирует одноразового пользователя
# и дальше ходит под его токеном. Запускай сверху вниз.
#
# Картинки лежат в http/fixtures. Пути в запросах считаются от этого файла.
# Тип файла должен проверяться по содержимому (magic numbers), а не по
# расширению и не по Content-Type части: и то, и другое клиент пишет что захочет.
###############################################################################

### Одноразовый пользователь для аватарок
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "login": "avatar_{{$timestamp}}",
  "email": "avatar_{{$timestamp}}@example.com",
  "password": "qwerty123",
  "age": 30
}

> {%
    client.global.set("avatar_access_token", response.body.access_token);
    client.global.set("avatar_refresh_token", response.body.refresh_token);
%}


### Запоминаем его id — сверим с userId в ответах
GET {{baseUrl}}/profile/my
Authorization: Bearer {{avatar_access_token}}

> {%
    client.global.set("avatar_user_id", response.body.id);
%}


# ─────────────────────────────────────────────────────────────────────────────
# СЧАСТЛИВЫЙ ПУТЬ — ожидаем 201 и запись об аватарке
# ─────────────────────────────────────────────────────────────────────────────

### PNG — ожидаем 201
POST {{baseUrl}}/profile/my/avatars
Authorization: Bearer {{avatar_access_token}}
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="avatar"; filename="avatar.png"
Content-Type: image/png

< ./fixtures/avatar.png
--boundary--

> {%
    client.test("png загружен = 201", function () {
        client.assert(response.status === 201, "ожидали 201, пришло " + response.status);
    });
    client.test("в ответе запись об аватарке", function () {
        client.assert(response.body.id !== undefined, "нет id");
        client.assert(response.body.name, "нет name");
        client.assert(response.body.createdAt, "нет createdAt");
    });
    client.test("аватарка привязана к текущему пользователю", function () {
        client.assert(response.body.userId === client.global.get("avatar_user_id"),
            "userId " + response.body.userId + " не совпал с id из профиля");
    });
    client.test("deletedAt наружу не отдаётся", function () {
        client.assert(!("deletedAt" in response.body), "deletedAt уехал клиенту");
    });
    client.test("имя файла с расширением .png", function () {
        client.assert(/\.png$/.test(response.body.name),
            "ожидали <uuid>.png, пришло " + response.body.name);
    });
    client.global.set("first_avatar_id", response.body.id);
    client.global.set("first_avatar_name", response.body.name);
%}


