### SVG — ожидаем 422
# SVG — это XML, внутри может быть <script>. Раздавать такое из бакета
# с public-read — готовый XSS. Поэтому для аватарок SVG не принимаем.
POST {{baseUrl}}/profile/my/avatars
Authorization: Bearer {{avatar_access_token}}
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="avatar"; filename="avatar.svg"
Content-Type: image/svg+xml

<svg xmlns="http://www.w3.org/2000/svg" width="10" height="10"><script>alert(1)</script></svg>
--boundary--

> {%
    client.test("svg = 422", function () {
        client.assert(response.status === 422, "ожидали 422, пришло " + response.status);
    });
%}


