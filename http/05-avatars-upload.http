POST {{baseUrl}}/profile/my/avatars
Authorization: Bearer {{upload_access}}
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="avatar"; filename="empty.png"
Content-Type: image/png

--boundary--

> {%
    client.test("422 Unprocessable Entity", () => client.assert(response.status === 422, `пришло ${response.status}`));
%}


# ═════════════════════════════════════════════════════════════════════════════
# КРИВОЙ ЗАПРОС — до S3 дело не доходит
# Multer срабатывает раньше pipe-а, и errorHttpStatusCode на него не влияет:
# свои ошибки он маппит сам (transformException в
# node_modules/@nestjs/platform-express/multer/multer/multer.utils.js).
# ═════════════════════════════════════════════════════════════════════════════

### Картинка в поле "file" вместо "avatar" — 400 (Unexpected field)
POST {{baseUrl}}/profile/my/avatars
Authorization: Bearer {{upload_access}}
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="file"; filename="avatar.png"
Content-Type: image/png

< ./fixtures/avatar.png
--boundary--

> {%
    client.test("400 Bad Request", () => client.assert(response.status === 400, `пришло ${response.status}`));
%}


### Две картинки в поле "avatar" — 400
# FileInterceptor — это multer.single(), второй файл в поле уже лишний.
POST {{baseUrl}}/profile/my/avatars
Authorization: Bearer {{upload_access}}
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="avatar"; filename="first.png"
Content-Type: image/png

< ./fixtures/avatar.png
--boundary
Content-Disposition: form-data; name="avatar"; filename="second.jpg"
Content-Type: image/jpeg

< ./fixtures/avatar.jpg
--boundary--

> {%
    client.test("400 Bad Request", () => client.assert(response.status === 400, `пришло ${response.status}`));
%}


### Multipart без файла, только текстовое поле — 422
POST {{baseUrl}}/profile/my/avatars
Authorization: Bearer {{upload_access}}
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="description"

файла нет
--boundary--

> {%
    client.test("422 Unprocessable Entity", () => client.assert(response.status === 422, `пришло ${response.status}`));
%}


### JSON вместо multipart — 422
# Multer пропускает не-multipart запросы мимо себя, файл просто не появляется.
POST {{baseUrl}}/profile/my/avatars
Authorization: Bearer {{upload_access}}
Content-Type: application/json

{
  "avatar": "это строка, а не файл"
}

> {%
    client.test("422 Unprocessable Entity", () => client.assert(response.status === 422, `пришло ${response.status}`));
%}


### Совсем пустой запрос — 422
POST {{baseUrl}}/profile/my/avatars
Authorization: Bearer {{upload_access}}

> {%
    client.test("422 Unprocessable Entity", () => client.assert(response.status === 422, `пришло ${response.status}`));
%}


# ═════════════════════════════════════════════════════════════════════════════
# ЛИМИТ РАЗМЕРА — 413
# ═════════════════════════════════════════════════════════════════════════════

### Файл 11 МБ — 413
# Лимит стоит в Multer, поэтому большой файл обрывается ещё на приёме.
# Фикстуры нет в git — один раз создай её в Git Bash:
#   head -c 11M /dev/urandom > http/fixtures/big.jpg
# Без неё этот запрос упадёт с ошибкой чтения файла.
POST {{baseUrl}}/profile/my/avatars
Authorization: Bearer {{upload_access}}
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="avatar"; filename="big.jpg"
Content-Type: image/jpeg

< ./fixtures/big.jpg
--boundary--

> {%
    client.test("413 Payload Too Large", () => client.assert(response.status === 413, `пришло ${response.status}`));
%}


# ═════════════════════════════════════════════════════════════════════════════
# ИТОГ — ни одна неудачная загрузка не создала запись
# ═════════════════════════════════════════════════════════════════════════════

### Пятая загрузка проходит — 201
# Удачных выше было четыре. Если бы хоть одна неудачная создала запись,
# лимит в 5 был бы уже исчерпан.
POST {{baseUrl}}/profile/my/avatars
Authorization: Bearer {{upload_access}}
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="avatar"; filename="avatar.png"
Content-Type: image/png

< ./fixtures/avatar.png
--boundary--

> {%
    client.test("201 Created", () => client.assert(response.status === 201, `пришло ${response.status}`));
%}


### Шестая — 409
POST {{baseUrl}}/profile/my/avatars
Authorization: Bearer {{upload_access}}
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="avatar"; filename="avatar.png"
Content-Type: image/png

< ./fixtures/avatar.png
--boundary--

> {%
    client.test("409 Conflict", () => client.assert(response.status === 409, `пришло ${response.status}`));
%}
