###############################################################################
# AVATARS UPLOAD — POST /profile/my/avatars
#
# Одна картинка (png или jpeg) в поле "avatar", до 10 МБ. Файл уходит
# в MinIO, в таблицу avatars пишется { id, name, userId, createdAt }.
# Тип определяется по содержимому (magic numbers), а не по расширению
# и не по Content-Type части — их клиент пишет какие хочет.
#
# Кто каким кодом отвечает:
#   JwtAuthGuard                       → 401
#   FileInterceptor (Multer)           → 400 чужое поле или два файла,
#                                        413 больше лимита
#   ParseFilePipe                      → 422 нет файла или не тот тип
#   AvatarsService                     → 409 уже 5 аватарок
#
# Самодостаточный. Нужен MinIO и бакет (см. README). Запуск — сверху вниз.
# Картинки лежат в http/fixtures, пути считаются от этого файла.
###############################################################################

### Одноразовый пользователь
# @name Одноразовый пользователь
< {%
    request.variables.set("login", "upload_" + Date.now());
%}
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "login": "{{login}}",
  "email": "{{login}}@example.com",
  "password": "{{password}}",
  "age": 30
}

> {%
    client.test("201 Created", () => client.assert(response.status === 201, `пришло ${response.status}`));
    client.global.set("upload_access", response.body.access_token);
    client.global.set("upload_refresh", response.body.refresh_token);
%}


### Его id — сверим с userId в ответах
GET {{baseUrl}}/profile/my
Authorization: Bearer {{upload_access}}

> {%
    client.global.set("upload_user_id", String(response.body.id));
%}


# ═════════════════════════════════════════════════════════════════════════════
# СЧАСТЛИВЫЙ ПУТЬ — 201
# ═════════════════════════════════════════════════════════════════════════════

### PNG — 201
POST {{baseUrl}}/profile/my/avatars
Authorization: Bearer {{upload_access}}
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="avatar"; filename="avatar.png"
Content-Type: image/png

< ./fixtures/avatar.png
--boundary--

> {%
    const body = response.body;
    client.test("201 Created", () => client.assert(response.status === 201, `пришло ${response.status}`));
    client.test("в ответе запись об аватарке", () => {
        client.assert(Number.isInteger(body.id), `id = ${body.id}`);
        client.assert(body.name, "нет name");
        client.assert(body.createdAt, "нет createdAt");
    });
    client.test("привязана к текущему пользователю", () => {
        client.assert(String(body.userId) === client.global.get("upload_user_id"), `userId = ${body.userId}`);
    });
    client.test("имя — <uuid>.png", () => {
        client.assert(/^[0-9a-f-]{36}\.png$/.test(body.name), `name = ${body.name}`);
    });
    client.test("deletedAt наружу не уходит", () => client.assert(!("deletedAt" in body), "в ответе есть deletedAt"));

    client.global.set("upload_first_id", String(body.id));
    client.global.set("upload_first_name", body.name);
%}


### JPEG — 201, расширение берётся из mime-типа: .jpeg
POST {{baseUrl}}/profile/my/avatars
Authorization: Bearer {{upload_access}}
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="avatar"; filename="avatar.jpg"
Content-Type: image/jpeg

< ./fixtures/avatar.jpg
--boundary--

> {%
    client.test("201 Created", () => client.assert(response.status === 201, `пришло ${response.status}`));
    client.test("имя — <uuid>.jpeg", () => {
        client.assert(/^[0-9a-f-]{36}\.jpeg$/.test(response.body.name), `name = ${response.body.name}`);
    });
%}


### Та же картинка ещё раз — новая запись с новым именем
# Старая не затирается ни в таблице, ни в бакете.
POST {{baseUrl}}/profile/my/avatars
Authorization: Bearer {{upload_access}}
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="avatar"; filename="avatar.png"
Content-Type: image/png

< ./fixtures/avatar.png
--boundary--

> {%
    client.test("201 Created", () => client.assert(response.status === 201, `пришло ${response.status}`));
    client.test("новые id и имя", () => {
        client.assert(String(response.body.id) !== client.global.get("upload_first_id"), "id совпал с первой загрузкой");
        client.assert(response.body.name !== client.global.get("upload_first_name"), "имя совпало — файл в бакете затёрт");
    });
%}


### Расширение и Content-Type врут, внутри PNG — 201 и сохранён как .png
POST {{baseUrl}}/profile/my/avatars
Authorization: Bearer {{upload_access}}
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="avatar"; filename="photo.jpg"
Content-Type: image/jpeg

< ./fixtures/avatar.png
--boundary--

> {%
    client.test("201 Created", () => client.assert(response.status === 201, `пришло ${response.status}`));
    client.test("сохранён по реальному типу", () => {
        client.assert(/\.png$/.test(response.body.name), `name = ${response.body.name}`);
    });
%}


