--boundary
Content-Disposition: form-data; name="avatar"; filename="avatar.png"
Content-Type: image/png

< ./fixtures/avatar.png
--boundary--

> {%
    client.test("401 Unauthorized", () => client.assert(response.status === 401, `пришло ${response.status}`));
%}


