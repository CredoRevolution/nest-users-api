# ─────────────────────────────────────────────────────────────────────────────
# РУЧНЫЕ ПРОВЕРКИ
# ─────────────────────────────────────────────────────────────────────────────

### Слишком большая картинка — ожидаем 413
# Лимит 10 МБ стоит в multer, поэтому гигабайтный файл отсекается ещё
# на приёме, а не после того, как целиком лёг в память.
# Как проверить: в Git Bash создай файл на 11 МБ из случайных байтов
#   head -c 11M /dev/urandom > http/fixtures/big.jpg
# Это не картинка, но Multer оборвёт приём по размеру раньше, чем кто-то
# посмотрит на содержимое. Файл в .gitignore, не коммить его.
POST {{baseUrl}}/profile/my/avatars
Authorization: Bearer {{avatar_access_token}}
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="avatar"; filename="big.jpg"
Content-Type: image/jpeg

< ./fixtures/big.jpg
--boundary--

> {%
    client.test("больше лимита = 413", function () {
        client.assert(response.status === 413, "ожидали 413, пришло " + response.status);
    });
%}


### MinIO лежит — ожидаем 400 (UploadException), и записи в базе быть не должно
# Как проверить: docker compose stop minio, выполни запрос, потом
# docker compose start minio. SDK сначала сделает несколько повторов,
# поэтому ответ придёт не сразу. UploadException наследует BadRequestException
# и бросается из сервиса, а не из pipe-а, так что errorHttpStatusCode тут
# ни при чём: отсюда 400, а не 422 и не 502/503 — решай сам, устраивает ли это.
POST {{baseUrl}}/profile/my/avatars
Authorization: Bearer {{avatar_access_token}}
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="avatar"; filename="avatar.png"
Content-Type: image/png

< ./fixtures/avatar.png
--boundary--
