# ═════════════════════════════════════════════════════════════════════════════
# НЕ ТОТ ТИП — 422
# ═════════════════════════════════════════════════════════════════════════════

### Текстовый файл — 422
POST {{baseUrl}}/profile/my/avatars
Authorization: Bearer {{upload_access}}
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="avatar"; filename="hello.txt"
Content-Type: text/plain

Привет, это не картинка.
--boundary--

> {%
    client.test("422 Unprocessable Entity", () => client.assert(response.status === 422, `пришло ${response.status}`));
%}


### Текст под видом PNG (имя .png, Content-Type image/png) — 422
# Главный тест: 201 здесь значило бы, что тип берётся со слов клиента.
POST {{baseUrl}}/profile/my/avatars
Authorization: Bearer {{upload_access}}
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="avatar"; filename="fake.png"
Content-Type: image/png

< ./fixtures/fake.png
--boundary--

> {%
    client.test("422 Unprocessable Entity", () => client.assert(response.status === 422, `пришло ${response.status}`));
%}


