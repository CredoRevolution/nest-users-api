Authorization: Bearer {{avatar_access_token}}
Content-Type: application/json

{
  "avatar": "это строка, а не файл"
}

> {%
    client.test("JSON вместо файла = 422", function () {
        client.assert(response.status === 422, "ожидали 422, пришло " + response.status);
    });
%}


