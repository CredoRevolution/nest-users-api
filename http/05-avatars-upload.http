### SVG — 422
# SVG — это XML, внутри может быть <script>. Раздавать такое из бакета
# с public-read — готовый XSS.
POST {{baseUrl}}/profile/my/avatars
Authorization: Bearer {{upload_access}}
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="avatar"; filename="avatar.svg"
Content-Type: image/svg+xml

<svg xmlns="http://www.w3.org/2000/svg" width="10" height="10"><script>alert(1)</script></svg>
--boundary--

> {%
    client.test("422 Unprocessable Entity", () => client.assert(response.status === 422, `пришло ${response.status}`));
%}


