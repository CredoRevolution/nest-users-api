%}


### C больше не находится по id — 404
GET {{baseUrl}}/users/{{users_c_id}}
Authorization: Bearer {{users_access}}

> {%
    client.test("404 Not Found", () => client.assert(response.status === 404, `пришло ${response.status}`));
%}


### C пропал из списка — трое
# URL отличается от первого поиска (добавлен limit), иначе пришёл бы
# закэшированный ответ, где C ещё есть.
GET {{baseUrl}}/users?login={{users_prefix}}&limit=10
Authorization: Bearer {{users_access}}

> {%
    const logins = response.body.data.map(user => user.login);
    client.test("200 OK", () => client.assert(response.status === 200, `пришло ${response.status}`));
    client.test("C в списке нет", () => {
        client.assert(!logins.includes(`${client.global.get("users_prefix")}_c`), `пришло ${logins}`);
        client.assert(response.body.meta.total === 3, `total = ${response.body.meta.total}`);
    });
%}
