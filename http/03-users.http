###############################################################################
# USERS — GET /users (пагинация, поиск по логину) и GET /users/:id.
#
# Самодостаточный. Создаёт четырёх пользователей с общим уникальным
# префиксом {{users_prefix}}:
#   <префикс>_a  <префикс>_b  <префикс>_c  <префикс>za
# и дальше ищет по этому префиксу — так результат не зависит от того,
# сколько ещё пользователей лежит в базе.
#
# Оба роута кэшируются на 30 секунд, ключ — URL. Поэтому каждый запрос,
# который проверяет содержимое, ходит на свой уникальный URL.
# Сам кэш проверяется в 07-cache.http.
###############################################################################

### Пользователь A — от его имени идут все запросы
# @name Пользователь A
< {%
    const prefix = "usr" + Date.now();
    client.global.set("users_prefix", prefix);
    request.variables.set("login", prefix + "_a");
%}
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "login": "{{login}}",
  "email": "{{login}}@example.com",
  "password": "{{password}}",
  "age": 20,
  "about": "пользователь A"
}

> {%
    client.test("201 Created", () => client.assert(response.status === 201, `пришло ${response.status}`));
    client.global.set("users_access", response.body.access_token);
%}


### Пользователь B
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "login": "{{users_prefix}}_b",
  "email": "{{users_prefix}}_b@example.com",
  "password": "{{password}}",
  "age": 30
}

> {%
    client.test("201 Created", () => client.assert(response.status === 201, `пришло ${response.status}`));
%}


### Пользователь C — его удалим
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "login": "{{users_prefix}}_c",
  "email": "{{users_prefix}}_c@example.com",
  "password": "{{password}}",
  "age": 40
}

> {%
    client.test("201 Created", () => client.assert(response.status === 201, `пришло ${response.status}`));
    client.global.set("users_c_access", response.body.access_token);
%}


### Пользователь «za» — ловушка для «_» как подстановочного символа LIKE
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "login": "{{users_prefix}}za",
  "email": "{{users_prefix}}za@example.com",
  "password": "{{password}}",
  "age": 50
}

> {%
    client.test("201 Created", () => client.assert(response.status === 201, `пришло ${response.status}`));
%}


# ═════════════════════════════════════════════════════════════════════════════
# СПИСОК
# ═════════════════════════════════════════════════════════════════════════════

### Без токена — 401
GET {{baseUrl}}/users

> {%
    client.test("401 Unauthorized", () => client.assert(response.status === 401, `пришло ${response.status}`));
%}


### Параметры по умолчанию — page 1, limit 10
GET {{baseUrl}}/users
Authorization: Bearer {{users_access}}

> {%
    const {data, meta} = response.body;
    client.test("200 OK", () => client.assert(response.status === 200, `пришло ${response.status}`));
    client.test("meta по умолчанию", () => {
        client.assert(meta.page === 1 && meta.limit === 10, JSON.stringify(meta));
        client.assert(meta.totalPages === Math.ceil(meta.total / meta.limit), JSON.stringify(meta));
    });
    client.test("не больше 10 записей", () => client.assert(data.length <= 10, `пришло ${data.length}`));
    client.test("служебные поля наружу не уходят", () => {
        for (const user of data) {
            for (const field of ["passwordHash", "tokenVersion", "deletedAt"]) {
                client.assert(!(field in user), `у ${user.login} есть ${field}`);
            }
        }
    });
    client.test("отсортировано по id", () => {
        for (let i = 1; i < data.length; i++) {
            client.assert(data[i - 1].id < data[i].id, `id ${data[i - 1].id} идёт перед ${data[i].id}`);
        }
    });
%}


### Поиск по префиксу — все четверо
GET {{baseUrl}}/users?login={{users_prefix}}
Authorization: Bearer {{users_access}}

> {%
    const prefix = client.global.get("users_prefix");
    const logins = response.body.data.map(user => user.login);

    client.test("200 OK", () => client.assert(response.status === 200, `пришло ${response.status}`));
    client.test("нашлись ровно наши четверо", () => {
        const expected = [`${prefix}_a`, `${prefix}_b`, `${prefix}_c`, `${prefix}za`];
        client.assert(JSON.stringify(logins) === JSON.stringify(expected), `пришло ${logins}`);
        client.assert(response.body.meta.total === 4, `total = ${response.body.meta.total}`);
    });

    const byLogin = Object.fromEntries(response.body.data.map(user => [user.login, user]));
    client.global.set("users_a_id", String(byLogin[`${prefix}_a`].id));
    client.global.set("users_c_id", String(byLogin[`${prefix}_c`].id));
%}


### Поиск по середине логина — ищется подстрока, а не только начало
# @name Поиск по середине логина
< {%
    request.variables.set("part", client.global.get("users_prefix").slice(3));
%}
GET {{baseUrl}}/users?login={{part}}
Authorization: Bearer {{users_access}}

> {%
    client.test("200 OK", () => client.assert(response.status === 200, `пришло ${response.status}`));
    client.test("нашлись все четверо", () => client.assert(response.body.meta.total === 4, `total = ${response.body.meta.total}`));
%}


### Поиск в верхнем регистре — ILIKE, регистр не важен
# @name Поиск в верхнем регистре
< {%
    request.variables.set("upper", client.global.get("users_prefix").toUpperCase());
%}
GET {{baseUrl}}/users?login={{upper}}
Authorization: Bearer {{users_access}}

> {%
    client.test("200 OK", () => client.assert(response.status === 200, `пришло ${response.status}`));
    client.test("нашлись все четверо", () => client.assert(response.body.meta.total === 4, `total = ${response.body.meta.total}`));
%}


### «_» ищется буквально, а не как «любой символ» — трое без «za»
GET {{baseUrl}}/users?login={{users_prefix}}_
Authorization: Bearer {{users_access}}

> {%
    const logins = response.body.data.map(user => user.login);
    client.test("200 OK", () => client.assert(response.status === 200, `пришло ${response.status}`));
    client.test("za не попал", () => {
        client.assert(response.body.meta.total === 3, `пришло ${logins} — «_» не экранирован в escapeLike`);
    });
%}


### «%» ищется буквально, а не как «что угодно» — пусто
# %25 — это закодированный «%».
GET {{baseUrl}}/users?login={{users_prefix}}%25a
Authorization: Bearer {{users_access}}

> {%
    client.test("200 OK", () => client.assert(response.status === 200, `пришло ${response.status}`));
    client.test("никого", () => {
        const logins = response.body.data.map(user => user.login);
        client.assert(response.body.meta.total === 0, `пришло ${logins} — «%» не экранирован в escapeLike`);
    });
%}


### Попытка SQL-инъекции — 200, ищется как обычная строка
# Значение: ' OR 1=1 --
GET {{baseUrl}}/users?login=%27%20OR%201%3D1%20--
Authorization: Bearer {{users_access}}

> {%
    client.test("200 OK", () => client.assert(response.status === 200, `пришло ${response.status}`));
    client.test("вернулись только логины с этой подстрокой", () => {
        for (const user of response.body.data) {
            client.assert(user.login.includes("' OR 1=1 --"), `лишний пользователь ${user.login}`);
        }
    });
%}


### Под фильтр никто не подходит — пустой список
GET {{baseUrl}}/users?login={{users_prefix}}_nobody
Authorization: Bearer {{users_access}}

> {%
    client.test("200 OK", () => client.assert(response.status === 200, `пришло ${response.status}`));
    client.test("пусто", () => {
        const {data, meta} = response.body;
        client.assert(data.length === 0 && meta.total === 0 && meta.totalPages === 0, JSON.stringify(response.body));
    });
%}


# ─────────────────────────────────────────────────────────────────────────────
# Пагинация на наших четверых
# ─────────────────────────────────────────────────────────────────────────────

### Страница 1 по 3 — трое, всего 2 страницы
GET {{baseUrl}}/users?login={{users_prefix}}&page=1&limit=3
Authorization: Bearer {{users_access}}

> {%
    const prefix = client.global.get("users_prefix");
    const {data, meta} = response.body;
    client.test("200 OK", () => client.assert(response.status === 200, `пришло ${response.status}`));
    client.test("первые трое по id", () => {
        const logins = data.map(user => user.login);
        client.assert(JSON.stringify(logins) === JSON.stringify([`${prefix}_a`, `${prefix}_b`, `${prefix}_c`]), `пришло ${logins}`);
    });
    client.test("meta", () => {
        client.assert(meta.page === 1 && meta.limit === 3 && meta.total === 4 && meta.totalPages === 2, JSON.stringify(meta));
    });
%}


### Страница 2 по 3 — один оставшийся
GET {{baseUrl}}/users?login={{users_prefix}}&page=2&limit=3
Authorization: Bearer {{users_access}}

> {%
    const {data, meta} = response.body;
    client.test("200 OK", () => client.assert(response.status === 200, `пришло ${response.status}`));
    client.test("только za", () => {
        client.assert(data.length === 1 && data[0].login === `${client.global.get("users_prefix")}za`, JSON.stringify(data));
    });
    client.test("meta.page = 2", () => client.assert(meta.page === 2, JSON.stringify(meta)));
%}


### Страница за пределами — 200 и пустой data, total прежний
GET {{baseUrl}}/users?login={{users_prefix}}&page=3&limit=3
Authorization: Bearer {{users_access}}

> {%
    client.test("200 OK", () => client.assert(response.status === 200, `пришло ${response.status}`));
    client.test("data пустой, total = 4", () => {
        client.assert(response.body.data.length === 0 && response.body.meta.total === 4, JSON.stringify(response.body.meta));
    });
%}


### limit = 1
GET {{baseUrl}}/users?login={{users_prefix}}&page=1&limit=1
Authorization: Bearer {{users_access}}

> {%
    client.test("200 OK", () => client.assert(response.status === 200, `пришло ${response.status}`));
    client.test("одна запись, 4 страницы", () => {
        client.assert(response.body.data.length === 1 && response.body.meta.totalPages === 4, JSON.stringify(response.body.meta));
    });
%}


### limit = 100 — граница, 200
GET {{baseUrl}}/users?page=1&limit=100
Authorization: Bearer {{users_access}}

> {%
    client.test("200 OK", () => client.assert(response.status === 200, `пришло ${response.status}`));
    client.test("не больше 100 записей", () => client.assert(response.body.data.length <= 100, `пришло ${response.body.data.length}`));
%}


