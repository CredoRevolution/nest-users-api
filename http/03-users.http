### id больше integer — 400, а не 500
# Колонка id — SERIAL (integer). Без @Max в IdParamDto Postgres упал бы
# с "value out of range" и наружу ушёл бы 500.
GET {{baseUrl}}/users/2147483648
Authorization: Bearer {{users_access}}

> {%
    client.test("400 Bad Request", () => client.assert(response.status === 400, `пришло ${response.status}`));
