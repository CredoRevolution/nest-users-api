### Неизвестный параметр — 400 (forbidNonWhitelisted)
# Сортировки нет. Если её делать, имя колонки параметром в SQL не передать —
# только подставлять в текст запроса после проверки по белому списку.
GET {{baseUrl}}/users?sortBy=passwordHash&order=ASC
Authorization: Bearer {{users_access}}

> {%
    client.test("400 Bad Request", () => client.assert(response.status === 400, `пришло ${response.status}`));
%}


# ═════════════════════════════════════════════════════════════════════════════
# ПОЛЬЗОВАТЕЛЬ ПО ID
# ═════════════════════════════════════════════════════════════════════════════

### Существующий — 200
GET {{baseUrl}}/users/{{users_a_id}}
Authorization: Bearer {{users_access}}

> {%
    client.test("200 OK", () => client.assert(response.status === 200, `пришло ${response.status}`));
    client.test("это пользователь A", () => {
        const body = response.body;
        client.assert(String(body.id) === client.global.get("users_a_id"), `id = ${body.id}`);
        client.assert(body.login === `${client.global.get("users_prefix")}_a`, `login = ${body.login}`);
        client.assert(body.age === 20 && body.about === "пользователь A", JSON.stringify(body));
    });
    client.test("служебные поля наружу не уходят", () => {
        for (const field of ["passwordHash", "tokenVersion", "deletedAt"]) {
            client.assert(!(field in response.body), `в ответе есть ${field}`);
        }
    });
%}


### Без токена — 401
GET {{baseUrl}}/users/{{users_a_id}}

> {%
    client.test("401 Unauthorized", () => client.assert(response.status === 401, `пришло ${response.status}`));
%}


