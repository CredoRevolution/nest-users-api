###############################################################################
# USERS — список пользователей.
#
# Первый запрос работает уже сейчас (GET /users без защиты).
# Всё, что ниже раздела «ШАГ 17», — заготовки под пагинацию и фильтр,
# имена query-параметров поменяй на свои, когда решишь, как их назвать.
###############################################################################

### Текущее состояние: список открыт всем, без токена. Это надо будет закрыть.
GET {{baseUrl}}/users

> {%
    client.test("сейчас список открыт всем", function () {
        client.assert(response.status === 200,
            "ожидали 200 — если пришло 401, значит ты уже закрыл роут гвардом");
    });
    client.test("в списке нет хэшей паролей", function () {
        client.assert(!JSON.stringify(response.body).includes("passwordHash"),
            "ХЭШИ ПАРОЛЕЙ ВСЕХ ЮЗЕРОВ УЕХАЛИ КЛИЕНТУ");
    });
%}


# ─────────────────────────────────────────────────────────────────────────────
# ШАГ 17 — ЕЩЁ НЕ РЕАЛИЗОВАНО
# Список только для авторизованных, с пагинацией и фильтром по логину.
# ─────────────────────────────────────────────────────────────────────────────

### [не реализовано] Список без токена — должно стать 401
GET {{baseUrl}}/users

> {%
    client.test("список закрыт для неавторизованных", function () {
        client.assert(response.status === 401,
            "пока 200 — роут ещё не закрыт гвардом");
    });
%}


### [не реализовано] Список с токеном, параметры по умолчанию
GET {{baseUrl}}/users
Authorization: Bearer {{access_token}}


### [не реализовано] Первая страница, по 10 записей
GET {{baseUrl}}/users?page=1&limit=10
Authorization: Bearer {{access_token}}


### [не реализовано] Вторая страница
GET {{baseUrl}}/users?page=2&limit=10
Authorization: Bearer {{access_token}}


### [не реализовано] Страница за пределами данных — ожидаем пустой массив, не ошибку
GET {{baseUrl}}/users?page=9999&limit=10
Authorization: Bearer {{access_token}}


### [не реализовано] limit = 1 — самая маленькая страница
GET {{baseUrl}}/users?page=1&limit=1
Authorization: Bearer {{access_token}}


### [не реализовано] Отрицательная страница — ожидаем 400
GET {{baseUrl}}/users?page=-1&limit=10
Authorization: Bearer {{access_token}}


### [не реализовано] page = 0 — ожидаем 400 (страницы нумеруются с единицы)
GET {{baseUrl}}/users?page=0&limit=10
Authorization: Bearer {{access_token}}


### [не реализовано] limit = 0 — ожидаем 400
GET {{baseUrl}}/users?page=1&limit=0
Authorization: Bearer {{access_token}}


### [не реализовано] Огромный limit — должен упереться в потолок, а не отдать всю базу
# Без верхней границы limit=999999 положит и базу, и приложение.
# Именно ради этого пагинация и делается.
GET {{baseUrl}}/users?page=1&limit=999999
Authorization: Bearer {{access_token}}


### [не реализовано] page буквами вместо числа — ожидаем 400
GET {{baseUrl}}/users?page=abc&limit=10
Authorization: Bearer {{access_token}}


### [не реализовано] Фильтр по логину целиком
GET {{baseUrl}}/users?login={{userLogin}}
Authorization: Bearer {{access_token}}


### [не реализовано] Фильтр по куску логина — поиск должен быть частичным
GET {{baseUrl}}/users?login=sas
Authorization: Bearer {{access_token}}


### [не реализовано] Фильтр в другом регистре — решишь сам, чувствителен ли поиск к регистру
GET {{baseUrl}}/users?login=SAS
Authorization: Bearer {{access_token}}


### [не реализовано] Фильтр, под который никто не подходит — ожидаем пустой массив
GET {{baseUrl}}/users?login=ябсдорфщ
Authorization: Bearer {{access_token}}


### [не реализовано] Фильтр вместе с пагинацией
GET {{baseUrl}}/users?login=sas&page=1&limit=5
Authorization: Bearer {{access_token}}


### [не реализовано] Спецсимволы в фильтре: символ % в LIKE значит «что угодно»
# Если подставлять значение в запрос конкатенацией строк, этот запрос вернёт
# всех пользователей. Правильный способ — параметризованный запрос,
# где значение уходит в базу отдельно от текста запроса.
GET {{baseUrl}}/users?login=%25
Authorization: Bearer {{access_token}}


### [не реализовано] Попытка SQL-инъекции в фильтре — ожидаем пустой результат, а не падение
# Если сломается — значит значение склеивается в SQL строкой. Это ровно та тема,
# которую спрашивают на блоке БД.
GET {{baseUrl}}/users?login=' OR 1=1 --
Authorization: Bearer {{access_token}}


### [не реализовано] Попытка отсортировать по произвольной колонке
# Сортировка — самое частое место инъекции: имя колонки нельзя передать
# параметром, его приходится подставлять в текст запроса. Значит имя обязано
# проверяться по белому списку разрешённых колонок.
GET {{baseUrl}}/users?sortBy=passwordHash&order=ASC
Authorization: Bearer {{access_token}}


### [не реализовано] Сортировка по несуществующей колонке — ожидаем 400, а не 500
GET {{baseUrl}}/users?sortBy=такой-колонки-нет
Authorization: Bearer {{access_token}}


### [не реализовано] Мягко удалённый пользователь не должен появляться в списке
# Выполни после DELETE из 02-profile.http и поищи удалённого по логину.
GET {{baseUrl}}/users?login={{userLogin}}
Authorization: Bearer {{access_token}}


### [не реализовано] Один пользователь по идентификатору
GET {{baseUrl}}/users/{{my_id}}
Authorization: Bearer {{access_token}}


### [не реализовано] Несуществующий идентификатор — ожидаем 404, а не 200 с пустотой
GET {{baseUrl}}/users/999999
Authorization: Bearer {{access_token}}


### [не реализовано] Идентификатор буквами — ожидаем 400
GET {{baseUrl}}/users/abc
Authorization: Bearer {{access_token}}
