### Загрузить PNG
POST {{baseUrl}}/profile/my/avatars
Authorization: Bearer {{access_token}}
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="avatar"; filename="avatar.png"
Content-Type: image/png

< ./fixtures/avatar.png
--boundary--

> {%
    if (response.status === 201) client.global.set("avatar_id", String(response.body.id));
%}


### Загрузить JPEG
POST {{baseUrl}}/profile/my/avatars
Authorization: Bearer {{access_token}}
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="avatar"; filename="avatar.jpg"
Content-Type: image/jpeg

< ./fixtures/avatar.jpg
--boundary--

> {%
    if (response.status === 201) client.global.set("avatar_id", String(response.body.id));
%}


### Удалить последнюю загруженную аватарку
DELETE {{baseUrl}}/profile/my/avatars/{{avatar_id}}
Authorization: Bearer {{access_token}}


# ═════════════════════════════════════════════════════════════════════════════
# 5. БАЛАНС И ТРАНЗАКЦИИ
#
# Баланс — numeric(12, 2), считает его база: UPDATE balance = balance + :amount.
# Перевод идёт одной транзакцией, поэтому списание без зачисления невозможно.
#
# Как проверить перевод руками:
#   «Вход dev_violetta» → «Запомнить получателя» → «Вход dev_sasha»
#   → «Пополнить на 100» → «Перевести получателю 10.01»
#   → «Баланс» у обоих: у одного −10.01, у другого +10.01
#
# Как увидеть откат:
#   «Пополнить на 100» → «Перевод с падением посреди транзакции» (500)
#   → «Баланс» не изменился, хотя списание внутри транзакции уже прошло.
#   В логе приложения видно START TRANSACTION → UPDATE → ROLLBACK.
# ═════════════════════════════════════════════════════════════════════════════

### Баланс
GET {{baseUrl}}/profile/my/balance
Authorization: Bearer {{access_token}}


### Запомнить получателя — текущий пользователь станет получателем переводов
GET {{baseUrl}}/profile/my
Authorization: Bearer {{access_token}}

> {%
    client.global.set("recipient_id", String(response.body.id));
    client.log(`Получатель переводов: ${response.body.login} (id ${response.body.id})`);
%}


### Пополнить на 100
POST {{baseUrl}}/profile/my/balance/deposit
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
  "amount": 100
}


### Списать 9.99
POST {{baseUrl}}/profile/my/balance/withdraw
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
  "amount": 9.99
}


### Перевести получателю 10.01
POST {{baseUrl}}/profile/my/balance/transfer
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
  "toUserId": {{recipient_id}},
  "amount": 10.01
}


### Перевод несуществующему — 404, списание откатывается
POST {{baseUrl}}/profile/my/balance/transfer
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
  "toUserId": 2147483647,
  "amount": 10
}


### Перевод больше баланса — 409
POST {{baseUrl}}/profile/my/balance/transfer
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
  "toUserId": {{recipient_id}},
  "amount": 1000000
}


### Перевод с падением посреди транзакции — 500, денег никто не теряет
# Роут /transfer/crash списывает деньги и бросает исключение, не дойдя
# до зачисления. Существует только вне production.
POST {{baseUrl}}/profile/my/balance/transfer/crash
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
  "toUserId": {{recipient_id}},
  "amount": 10
}


### Баланс после падения — должен быть прежним
GET {{baseUrl}}/profile/my/balance
Authorization: Bearer {{access_token}}


# ═════════════════════════════════════════════════════════════════════════════
# 6. ПРОВЕРКИ, КОТОРЫЕ НЕ АВТОМАТИЗИРУЮТСЯ
# ═════════════════════════════════════════════════════════════════════════════

### Истёкший access-токен — ждём 401
# В .env поставь JWT_ACCESS_EXPIRES=10s, перезапусти приложение, войди,
# подожди 15 секунд и выполни запрос. Потом верни 15m.
GET {{baseUrl}}/profile/my
Authorization: Bearer {{access_token}}


### MinIO лежит — ждём 400 (UploadException), запись в базе не создаётся
# docker compose stop minio → запрос → docker compose start minio.
# SDK сначала делает несколько повторов, ответ придёт не сразу.
POST {{baseUrl}}/profile/my/avatars
Authorization: Bearer {{access_token}}
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="avatar"; filename="avatar.png"
Content-Type: image/png

< ./fixtures/avatar.png
--boundary--


### Redis лежит — что будет: 200 из базы, 500 или падение приложения?
# docker compose stop redis → этот запрос → смотри ответ и лог приложения.
# Потом docker compose start redis. Хорошее поведение — 200 без кэша.
GET {{baseUrl}}/users/{{user_id}}
Authorization: Bearer {{access_token}}

> scripts/show-cache.js


# ─────────────────────────────────────────────────────────────────────────────
# Заглянуть в Redis руками (из PowerShell):
#
#   docker exec -it nest-users-redis redis-cli -a redis_pass
#
#   KEYS *                 все закэшированные URL
#   GET /users/5           что лежит: {"value": ..., "expires": ...}
#   PTTL /users/5          сколько миллисекунд осталось жить
#   DEL /users/5           сбросить один ключ
#   FLUSHALL               сбросить весь кэш
# ─────────────────────────────────────────────────────────────────────────────
