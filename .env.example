# Приложение. 3200 — на этот порт смотрят запросы из http/.
PORT=3200

# База. Значения совпадают с compose.yaml — для локального запуска менять нечего.
# Хост именно localhost: в докере поднимается только Postgres, приложение
# запускается в терминале и ходит в проброшенный порт.
DB_HOST=localhost
DB_PORT=5432
DB_USER=nestuser
DB_PASSWORD=nestpass
DB_NAME=nest_users

# JWT. Для локального запуска подойдут любые строки, для прода — свои длинные секреты.
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_REFRESH_EXPIRES=7d

# MinIO — S3-совместимое хранилище аватарок. Ключ и бакет создаёт
# сервис minio-init из compose.yaml по этим же значениям.
MINIO_ACCESS_KEY=nestapp
MINIO_SECRET_KEY=nestapp-secret-123
S3_BUCKET_NAME=avatars
S3_ENDPOINT=http://127.0.0.1:9000

# Redis — кэш ответов и очередь BullMQ. Пароль и порт читает и compose.yaml,
# поэтому .env должен существовать до docker compose up.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_pass
REDIS_USERNAME=default
